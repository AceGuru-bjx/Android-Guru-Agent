{
  "schema": "apex-mcp-catalog-v1",
  "category": "communication",
  "categoryLabel": "通信协作",
  "entries": [
    {
      "id": "server-slack",
      "name": "Slack (参考实现)",
      "description": "Reference Slack server: channels/messages/users via Web API (archived)",
      "descriptionZh": "Slack 参考实现服务器：频道/消息/用户（已归档）",
      "transport": "STDIO",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-slack"
      ],
      "envSchema": [
        {
          "key": "SLACK_BOT_TOKEN",
          "required": true,
          "description": "Slack Bot User OAuth Token（xoxb- 开头）"
        },
        {
          "key": "SLACK_TEAM_ID",
          "required": true,
          "description": "Slack 团队 ID（T 开头）"
        },
        {
          "key": "SLACK_CHANNEL_IDS",
          "required": false,
          "description": "可选：逗号分隔限定可访问频道"
        }
      ],
      "runtime": "node",
      "tier": "agent",
      "risk": "medium",
      "sandboxOnly": true,
      "homepage": "https://github.com/modelcontextprotocol/servers-archived/tree/main/src/slack",
      "notes": "官方 reference servers 已归档（servers-archived），仍可安装使用。 托管远端形态见 remote/slack-remote。"
    }
  ]
}
